# ─────────────────────────────────────────────────
# SwitchAI — Environment Configuration
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# Do NOT commit .env — it is gitignored.

# ── Server ───────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ── Data Layer ───────────────────────────────────
# "memory" = in-memory store (no DB required)
# "mongodb" = real MongoDB (requires MONGODB_URI)
DATA_MODE=memory
MONGODB_URI=mongodb://127.0.0.1:27017/switchai

# ── Demo Mode ────────────────────────────────────
# When true, seeds sample incidents and uses mock AI
DEMO_MODE=true

# ── Switch Integration ───────────────────────────
# Set to true only after configuring a Switch room.
# These are placeholder variable names — adapt to
# the official Switch documentation when connecting.
SWITCH_ENABLED=false
SWITCH_BASE_URL=
SWITCH_ROOM_ID=
SWITCH_AGENT_NAME=SwitchAI
SWITCH_AUTH_TOKEN=replace_later

# ── AI / LLM Provider ───────────────────────────
# "mock" = built-in demo responses (no API key needed)
# "openai" = OpenAI-compatible provider
LLM_PROVIDER=mock
OPENAI_API_KEY=replace_later
OPENAI_MODEL=gpt-4
